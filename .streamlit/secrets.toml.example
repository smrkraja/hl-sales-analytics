# Copy to .streamlit/secrets.toml (gitignored) and fill in ONE provider.
# Register a web app with your identity provider using the redirect URI below.

[auth]
redirect_uri = "http://localhost:8599/oauth2callback"
# Long random string; generate with: python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = ""
client_id = ""
client_secret = ""

# Microsoft Entra ID (Azure AD) - replace <tenant-id>:
server_metadata_url = "https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration"

# Okta - replace <your-domain>:
# server_metadata_url = "https://<your-domain>.okta.com/.well-known/openid-configuration"

# Google Workspace:
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
