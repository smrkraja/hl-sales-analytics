# Optional: enables Claude-written narrative summaries on the Insights page
ANTHROPIC_API_KEY=

# Local development only: run without sign-in when .streamlit/secrets.toml has no [auth] section.
# Never set this on a shared or deployed server.
# HL_ALLOW_ANONYMOUS=1

# Demo/testing only: pretend every session signs in from this city (drives the landmark banner).
# HL_STUB_LOCATION=San Francisco, CA, US
